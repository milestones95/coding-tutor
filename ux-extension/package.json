{
  "name": "coding-tutor-capture",
  "version": "0.2.0",
  "private": true,
  "description": "Captures LeetCode practice (code snapshots, Run and Submit results) into data/capture.db. No LLM calls (D-015).",
  "type": "module",
  "engines": {
    "node": ">=20.19.5 <21"
  },
  "scripts": {
    "start": "tsx server/src/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test ../tests/unit/capture/*.test.ts",
    "seed:problems": "tsx server/src/seed-problems.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
